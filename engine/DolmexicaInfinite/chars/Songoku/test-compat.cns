; ============================================================================
; COMMAND DEFINITIONS
; ============================================================================
; Add these to songoku.cmd or include them via st4=test-compat.cns
; The engine reads [Command] entries from .cmd files.
; Since we're adding as st4, we need to define commands here too.
; ============================================================================

[Command]
name = "Test_IfElse"
command = D, D, x
time = 30

[Command]
name = "Test_Cond"
command = D, D, y
time = 30

[Command]
name = "Test_GetHitVar"
command = D, D, z
time = 30

[Command]
name = "Test_hitonce_normal"
command = D, F, x
time = 30

[Command]
name = "Test_hitonce_throw"
command = D, F, y
time = 30

[Command]
name = "Test_hitonce_explicit0"
command = D, F, z
time = 30

[Command]
name = "Test_hitonce_explicit1"
command = D, F, a
time = 30

[Command]
name = "Test_hitonce_throw0"
command = D, F, b
time = 30

[Command]
name = "Test_palfx_color"
command = D, B, x
time = 30

[Command]
name = "Test_palfx_invertall"
command = D, B, y
time = 30

[Command]
name = "Test_palfx_sinadd"
command = D, B, z
time = 30

[Command]
name = "Test_palfx_combined"
command = D, B, a
time = 30

[Command]
name = "Test_palfx_time0"
command = D, B, b
time = 30

[Command]
name = "Test_destroy_recursive0"
command = D, D, F, x
time = 40

[Command]
name = "Test_destroy_recursive1"
command = D, D, F, y
time = 40

[Command]
name = "Test_destroy_removeexplods0"
command = D, D, F, z
time = 40

[Command]
name = "Test_destroy_removeexplods1"
command = D, D, F, a
time = 40

[Command]
name = "Test_destroy_rec1_rem0"
command = D, D, F, b
time = 40

[Command]
name = "Test_destroy_rec1_rem1"
command = D, D, F, c
time = 40

; ============================================================================
; STATE -2: Command handlers (run in any state)
; ============================================================================

[Statedef -2]

[State -2, IfElse]
type = ChangeState
trigger1 = command = "Test_IfElse"
value = 12000
ctrl = 0

[State -2, Cond]
