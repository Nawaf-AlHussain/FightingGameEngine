; ============================================================================
; MUGEN 1.1 Compatibility Test States
; ============================================================================
; This file contains test states for verifying MUGEN 1.1 compatibility.
;
; Usage:
;   1. Add "st4 = test-compat.cns" to Songoku's songoku.def [Files] section
;   2. Start a match as Songoku
;   3. Use the button combinations listed below to trigger each test
;   4. Observe the clipboard (Ctrl+D in debug mode) for test results
;
; All tests use DisplayToClipboard to output results.
; Enable debug mode with Ctrl+D to see the clipboard.
;
; Button notation:
;   x = light punch    y = medium punch    z = heavy punch
;   a = light kick     b = medium kick     c = heavy kick
;   F = hold forward   B = hold back       U = up   D = down
; ============================================================================

; ============================================================================
; TEST 1: IfElse eager evaluation
; ============================================================================
; Trigger: D, D, x  (press Down twice then Light Punch)
; Expected: BOTH var(50) and var(51) are set to 1 (eager evaluation)
; If only var(50) is 1, IfElse is lazy (BUG)
; ============================================================================

[Statedef 12000]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0

[State 12000, Reset]
type = VarSet
trigger1 = Time = 0
v = 50
value = 0

[State 12000, Reset2]
type = VarSet
trigger1 = Time = 0
v = 51
value = 0

[State 12000, IfElseTest]
type = VarSet
trigger1 = Time = 0
v = 52
value = IfElse(1, var(50) := 1, var(51) := 1)

[State 12000, Display]
type = DisplayToClipboard
trigger1 = Time = 0
text = "IfElse: var50=%d var51=%d (expect both=1 for eager)"
params = var(50), var(51)

[State 12000, End]
type = ChangeState
trigger1 = Time = 10
value = 0
ctrl = 1

; ============================================================================
; TEST 2: Cond lazy evaluation
; ============================================================================
; Trigger: D, D, y  (press Down twice then Medium Punch)
; Expected: ONLY var(50) is set to 1 (lazy evaluation)
; If both var(50) and var(51) are 1, Cond is eager (BUG)
; ============================================================================

[Statedef 12001]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0

[State 12001, Reset]
type = VarSet
trigger1 = Time = 0
v = 50
value = 0

[State 12001, Reset2]
type = VarSet
trigger1 = Time = 0
v = 51
value = 0

[State 12001, CondTest]
type = VarSet
trigger1 = Time = 0
v = 52
value = Cond(1, var(50) := 1, var(51) := 1)

[State 12001, Display]
type = DisplayToClipboard
trigger1 = Time = 0
text = "Cond: var50=%d var51=%d (expect only var50=1 for lazy)"
params = var(50), var(51)

[State 12001, End]
type = ChangeState
trigger1 = Time = 10
value = 0
ctrl = 1

; ============================================================================
; TEST 3: GetHitVar(slidetime)
; ============================================================================
; Trigger: D, D, z  (press Down twice then Heavy Punch)
; This state creates a HitDef with ground.slidetime=30, then when P2
; is hit, P2's clipboard shows GetHitVar(slidetime).
; NOTE: This test requires P2 to be hit. Use a training dummy.
; ============================================================================

[Statedef 12002]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

[State 12002, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NA
hitflag = MAF
damage = 10
pausetime = 10, 10
ground.slidetime = 30
ground.hittime = 20
ground.velocity = -5
air.velocity = -2, -4
sparkxy = 0, -60
; hitonce = 0 (default for non-throw — tests our fix)

[State 12002, Display]
type = DisplayToClipboard
trigger1 = movehit
text = "HitDef: slidetime=30. P2 GetHitVar(slidetime)=%d"
params = gethitvar(slidetime)

[State 12002, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

; ============================================================================
; TEST 4: hitonce defaults
; ============================================================================
; Test 4a: Normal attr, hitonce omitted (should default to 0)
; Trigger: D, F, x
; Test 4b: Throw attr, hitonce omitted (should default to 1)
; Trigger: D, F, y
; Test 4c: Normal attr, explicit hitonce=0
; Trigger: D, F, z
; Test 4d: Normal attr, explicit hitonce=1
; Trigger: D, F, a
; Test 4e: Throw attr, explicit hitonce=0 (should override throw default)
; Trigger: D, F, b
; ============================================================================

[Statedef 12010]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

[State 12010, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NA
hitflag = MAF
damage = 10
pausetime = 5, 5
; hitonce NOT specified — should default to 0 for non-throw

[State 12010, Display]
type = DisplayToClipboard
trigger1 = movehit
text = "hitonce test 4a: normal omitted -> %d (expect 0)"
params = gethitvar(hitonce)

[State 12010, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[Statedef 12011]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

[State 12011, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NT
hitflag = M-
damage = 50
pausetime = 5, 5
p1stateno = 12011
p2stateno = 12011
; hitonce NOT specified — should default to 1 for throw

[State 12011, Display]
type = DisplayToClipboard
trigger1 = movehit
text = "hitonce test 4b: throw omitted -> %d (expect 1)"
params = gethitvar(hitonce)

[State 12011, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[Statedef 12012]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

[State 12012, HitDef]
