[State 12013, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[Statedef 12014]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

[State 12014, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NT
hitflag = M-
damage = 50
pausetime = 5, 5
p1stateno = 12014
p2stateno = 12014
hitonce = 0

[State 12014, Display]
