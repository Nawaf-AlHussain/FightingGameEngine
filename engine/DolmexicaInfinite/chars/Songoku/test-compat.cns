trigger1 = Time = 0
attr = S, NA
hitflag = MAF
damage = 10
pausetime = 5, 5
hitonce = 0

[State 12012, Display]
type = DisplayToClipboard
trigger1 = movehit
text = "hitonce test 4c: explicit 0 -> %d (expect 0)"
params = gethitvar(hitonce)

[State 12012, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[Statedef 12013]
type = S
movetype = A
physics = S
ctrl = 0
anim = 200

[State 12013, HitDef]
type = HitDef
trigger1 = Time = 0
attr = S, NA
hitflag = MAF
