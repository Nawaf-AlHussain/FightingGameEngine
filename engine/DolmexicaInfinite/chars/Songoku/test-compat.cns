; ============================================================================
; TEST 6: DestroySelf recursive/removeexplods
; ============================================================================
; Test 6a: recursive=0 (only self destroyed, children reparented)
; Trigger: D, D, F, x
; Test 6b: recursive=1 (self + all descendants destroyed)
; Trigger: D, D, F, y
; Test 6c: removeexplods=0 (explods survive as orphaned)
; Trigger: D, D, F, z
; Test 6d: removeexplods=1 (explods removed)
; Trigger: D, D, F, a
; Test 6e: recursive=1 + removeexplods=0
; Trigger: D, D, F, b
; Test 6f: recursive=1 + removeexplods=1
; Trigger: D, D, F, c
; ============================================================================

; --- 6a: recursive=0 ---
[Statedef 12030]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0

[State 12030, CreateHelper]
type = Helper
trigger1 = Time = 0
helpertype = normal
name = "TestChild"
ID = 1000
pos = 50, 0
postype = p1
stateno = 12031
keyctrl = 0
ownpal = 1

[State 12030, Wait]
type = ChangeState
trigger1 = Time = 30
value = 12032

; Child helper
[Statedef 12031]
type = S
movetype = I
physics = N
ctrl = 0
anim = 0

[State 12031, Display]
type = DisplayToClipboard
trigger1 = 1
text = "Child helper alive (state 12031)"

[State 12031, Persist]
type = ChangeState
trigger1 = 1
value = 12031

; Destroy with recursive=0
[Statedef 12032]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0

[State 12032, Destroy]
type = DestroySelf
trigger1 = Time = 0
recursive = 0
removeexplods = 0

; --- 6b: recursive=1 ---
[Statedef 12033]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0

[State 12033, CreateHelper]
type = Helper
trigger1 = Time = 0
helpertype = normal
name = "TestChild2"
ID = 1001
pos = 50, 0
postype = p1
stateno = 12034
keyctrl = 0
ownpal = 1

[State 12033, Wait]
type = ChangeState
trigger1 = Time = 30
value = 12035

; Child helper
[Statedef 12034]
