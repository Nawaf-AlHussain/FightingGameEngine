include Makefile.common
# Filter out the generic soundeffect.o and sound.o — the web-specific
# implementations (web/soundeffect_web.o, web/sound_web.o) use SDL_mixer
# instead of FMOD and provide the same public API.
OBJS := $(filter-out soundeffect.o sound.o,$(OBJS))
OBJS += windows/drawing_win.o windows/texture_win.o windows/input_win.o \
windows/framerateselect_win.o windows/file_win.o windows/math_win.o windows/system_win.o windows/log_win.o \
web/soundeffect_web.o web/sound_web.o windows/memoryhandler_win.o web/netplay_web.o windows/romdisk_win.o \
windows/saveload_win.o windows/screeneffect_win.o windows/logoscreen_win.o web/windowfocusscreen_web.o \
web/thread_web.o

all: $(TARGET)

PRISM_PATH = /mnt/c/DEV/PROJECTS/addons/prism
include Makefile.commonweb

clean_library:
	-rm *.o
	-cd windows && rm *.o
	-cd web && rm *.o
	-rm -r -f bin
	
libprism.a: $(OBJS)
	emar rcs $@ $(OBJS)
	-mkdir bin
	mv $@ bin/$@
	
	